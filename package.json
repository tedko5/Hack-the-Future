{
  "name": "hack-the-future",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.18"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "drizzle-kit migrate && node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@clerk/localizations": "^4.26.3",
    "@clerk/tanstack-react-start": "^1.7.19",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.7",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^1.71.0",
    "nitro": "3.0.260610-beta",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
